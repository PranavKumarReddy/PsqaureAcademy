{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "PsquareDevADF"
		},
		"ADLSDev_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLSDev_LS'"
		},
		"ADLSUAT_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLSUAT_LS'"
		},
		"AzureSqlDatabase_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase_LS'"
		},
		"ADLSDev_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://psquareadls.dfs.core.windows.net/"
		},
		"ADLSUAT_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://psquareadlsuat.dfs.core.windows.net/"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "psquareserver.database.windows.net"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-9710002"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "psquareadmin"
		},
		"RestService2_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": " https://www.gov.uk/"
		},
		"Rest_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://www.gov.uk/bank-holidays.json"
		},
		"EventBased_tr_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/f40da08b-7677-4efd-8bb4-f782cfb41acc/resourceGroups/Psquarebatch-1/providers/Microsoft.Storage/storageAccounts/psquareadls"
		},
		"TumblingWindow_tr_properties_pipeline_parameters_TableName": {
			"type": "string",
			"defaultValue": "DimOrders"
		},
		"scheduled_tr_properties_PL_Session17_parameters_TableName": {
			"type": "string",
			"defaultValue": "DimCustomer"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "PsquareDevADF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADLSDev_LS_accountKey": {
						"value": "[parameters('ADLSDev_LS_accountKey')]"
					},
					"ADLSUAT_LS_accountKey": {
						"value": "[parameters('ADLSUAT_LS_accountKey')]"
					},
					"AzureSqlDatabase_LS_password": {
						"value": "[parameters('AzureSqlDatabase_LS_password')]"
					},
					"ADLSDev_LS_properties_typeProperties_url": {
						"value": "[parameters('ADLSDev_LS_properties_typeProperties_url')]"
					},
					"ADLSUAT_LS_properties_typeProperties_url": {
						"value": "[parameters('ADLSUAT_LS_properties_typeProperties_url')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_userName')]"
					},
					"RestService2_LS_properties_typeProperties_url": {
						"value": "[parameters('RestService2_LS_properties_typeProperties_url')]"
					},
					"Rest_LS_properties_typeProperties_url": {
						"value": "[parameters('Rest_LS_properties_typeProperties_url')]"
					},
					"EventBased_tr_properties_typeProperties_scope": {
						"value": "[parameters('EventBased_tr_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "PsquareDevADF_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"TumblingWindow_tr_properties_pipeline_parameters_TableName": {
						"value": "[parameters('TumblingWindow_tr_properties_pipeline_parameters_TableName')]"
					},
					"scheduled_tr_properties_PL_Session17_parameters_TableName": {
						"value": "[parameters('scheduled_tr_properties_PL_Session17_parameters_TableName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'PsquareDevADF_ArmTemplate_0')]"
			]
		}
	]
}